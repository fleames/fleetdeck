# Public FleetDeck agent relay (deploy on your VPS / CDN host)
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download
COPY apps/api/ ./
RUN CGO_ENABLED=0 go build -o /fleetdeck-relay ./cmd/fleetdeck-relay

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /fleetdeck-relay /app/fleetdeck-relay
ENV RELAY_ADDR=:8090
EXPOSE 8090
USER nobody
ENTRYPOINT ["/app/fleetdeck-relay"]

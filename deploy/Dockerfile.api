# Build API
FROM golang:1.26-alpine AS apibuild
WORKDIR /src
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download
COPY apps/api/ ./
RUN CGO_ENABLED=0 go build -o /fleetdeck-api ./cmd/fleetdeck-api

# Build Linux agent binaries (served by /install.sh)
FROM golang:1.26-alpine AS agentbuild
WORKDIR /src
COPY apps/agent/go.mod apps/agent/go.sum ./
RUN go mod download
COPY apps/agent/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /linux-amd64 ./cmd/fleetdeck-agent
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -ldflags="-s -w" -o /linux-arm64 ./cmd/fleetdeck-agent

# Build Windows RMM agent (served by /install/rmm/windows/amd64)
FROM golang:1.26-alpine AS rmmbuild
WORKDIR /src
COPY apps/rmm-agent/go.mod apps/rmm-agent/go.sum ./
RUN go mod download
COPY apps/rmm-agent/ ./
RUN CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -ldflags="-s -w" -o /windows-amd64.exe ./cmd/fleetdeck-rmm

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=apibuild /fleetdeck-api /app/fleetdeck-api
COPY --from=agentbuild /linux-amd64 /app/agent-dist/linux-amd64
COPY --from=agentbuild /linux-arm64 /app/agent-dist/linux-arm64
COPY --from=rmmbuild /windows-amd64.exe /app/rmm-dist/windows-amd64
COPY cdn/fleetdeck/install-rmm.ps1 /app/rmm-dist/install-rmm.ps1
ENV AGENT_DIST_DIR=/app/agent-dist
ENV RMM_DIST_DIR=/app/rmm-dist
EXPOSE 8080
USER nobody
ENTRYPOINT ["/app/fleetdeck-api"]

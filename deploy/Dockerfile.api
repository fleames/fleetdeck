# Build API
FROM golang:1.26-alpine AS apibuild
WORKDIR /src
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download
COPY apps/api/ ./
RUN CGO_ENABLED=0 go build -o /fleetdeck-api ./cmd/fleetdeck-api

# Build Linux agent binaries (served by /install.sh)
FROM golang:1.26-alpine AS agentbuild
WORKDIR /src
COPY apps/agent/go.mod apps/agent/go.sum ./
RUN go mod download
COPY apps/agent/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /linux-amd64 ./cmd/fleetdeck-agent
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -ldflags="-s -w" -o /linux-arm64 ./cmd/fleetdeck-agent

FROM alpine:3.24
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=apibuild /fleetdeck-api /app/fleetdeck-api
COPY --from=agentbuild /linux-amd64 /app/agent-dist/linux-amd64
COPY --from=agentbuild /linux-arm64 /app/agent-dist/linux-arm64
ENV AGENT_DIST_DIR=/app/agent-dist
EXPOSE 8080
USER nobody
ENTRYPOINT ["/app/fleetdeck-api"]

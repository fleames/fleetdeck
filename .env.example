# FleetDeck local development — copy to .env and adjust.
# Never commit real secrets.

POSTGRES_USER=fleetdeck
POSTGRES_PASSWORD=fleetdeck_dev_change_me
POSTGRES_DB=fleetdeck
DATABASE_URL=postgres://fleetdeck:fleetdeck_dev_change_me@localhost:5433/fleetdeck?sslmode=disable

API_ADDR=:8080
# URL remote agents use (Cloudflare Tunnel hostname). Dashboard stays on localhost.
API_PUBLIC_URL=https://agents.tarkovbot.com
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# 32+ char secret used to derive AES-GCM keys for the `secrets` table (envelope encryption).
# Sessions are opaque DB-hashed tokens — not signed with this value.
# Generate: openssl rand -base64 48
SESSION_SECRET=dev-only-replace-with-openssl-rand-base64-48-chars-min

# Metrics
DEFAULT_METRIC_INTERVAL_SECONDS=10
METRICS_RAW_RETENTION_DAYS=7
METRICS_5M_RETENTION_DAYS=30
METRICS_1H_RETENTION_DAYS=365

# Agent offline if no heartbeat beyond this many seconds
AGENT_OFFLINE_AFTER_SECONDS=45

# Set true behind HTTPS reverse proxy (enables Secure cookies + HSTS on API responses).
# Keep false for local http://localhost (Secure=true on plain HTTP drops the session cookie).
COOKIE_SECURE=false

# Empty NEXT_PUBLIC_API_URL = browser uses same-origin /api (Next rewrites to the API).
# Setting this to http://localhost:8080 makes cookies cross-origin and can kick users to sign-in on refresh.
NEXT_PUBLIC_API_URL=
# Next.js rewrite target (docker service name, or http://127.0.0.1:8080 for local next dev).
API_INTERNAL_URL=http://api:8080

# Directory of Linux agent binaries for offline install-bundle (Compose image defaults to /app/agent-dist)
# AGENT_DIST_DIR=C:\Users\Ryzen3D\Projects\fleetdeck\dist\agent\0.4.0-dev

# Public CDN for remote VPS agent install (install.sh + linux-amd64/arm64)
AGENT_CDN_BASE=https://cdn.tarkovbot.com/fleetdeck
AGENT_CDN_CHANNEL=latest
# Expected agent release shown in panel (matches apps/agent const; override when publishing)
AGENT_VERSION=0.4.3-dev

# Cloudflare R2 — publish-cdn.ps1 / release-agent.ps1 auto-upload when these are set
# Dashboard → R2 → Manage R2 API Tokens → Object Read & Write on your public CDN bucket
# Skip upload: .\scripts\publish-cdn.ps1 -NoUpload   Force: -Upload
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public URL used for post-upload checks (default below)
# R2_PUBLIC_BASE=https://cdn.tarkovbot.com/fleetdeck

# Cloudflare Tunnel (recommended) — automated via scripts/setup-cloudflare-tunnel.ps1
# Manual: Zero Trust → Tunnels → copy token here, then .\scripts\start.ps1
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Legacy custom relay — leave empty when using Cloudflare Tunnel
# RELAY_URL=
# RELAY_TOKEN=
# RELAY_LOCAL_URL=http://127.0.0.1:8080

# Optional alert webhook (JSON POST on alert.fired / alert.resolved).
# Settings UI key alerts.webhook_url overrides this when set.
# ALERT_WEBHOOK_URL=https://hooks.example.com/fleetdeck
